{
  "name": "podium",
  "displayName": "Podium",
  "version": "1.0.0",
  "description": "Real-time agent observer dashboard for Claude Code. Visualizes every tool call, agent spawn, and session lifecycle in Maestro orchestration runs.",
  "author": "WP Media",
  "license": "MIT",
  "repository": "https://github.com/wp-media/podium",
  "entry": {
    "install": "node install.mjs",
    "hook": "node hook.mjs",
    "server": "node server.mjs"
  },
  "hooks": {
    "SessionStart": true,
    "UserPromptSubmit": true,
    "PreToolUse": true,
    "PostToolUse": true,
    "PostToolUseFailure": true,
    "SubagentStart": true,
    "SubagentStop": true,
    "SessionEnd": true
  },
  "server": {
    "port": 4820,
    "command": "node server.mjs"
  }
}
